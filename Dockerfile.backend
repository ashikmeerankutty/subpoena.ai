# One image for the three Python services; Cloud Run picks the entrypoint per service via APP:
#   api        subpoena_api.main:create_app
#   mcp        subpoena_mcp.app:create_app
#   courtroom  subpoena_agents.service:create_app
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.12.6 /uv /bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1
COPY pyproject.toml uv.lock .python-version ./
COPY packages packages
COPY apps/api apps/api
COPY apps/mcp-server apps/mcp-server
COPY apps/agents apps/agents
RUN uv sync --locked --no-dev --package subpoena-agents
COPY data/seed data/seed
ENV PATH="/app/.venv/bin:$PATH" SUBPOENA_SEED_DIR=/app/data/seed PORT=8080 APP=subpoena_api.main:create_app
CMD ["sh", "-c", "exec uvicorn ${APP} --factory --host 0.0.0.0 --port ${PORT} --timeout-keep-alive 75"]
