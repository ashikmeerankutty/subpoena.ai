# Copy to .env for local overrides. Never commit real values; demo/prod read secrets from Secret Manager.
SUBPOENA_ENV=local                 # local | test | demo | prod
SUBPOENA_STORE=memory              # memory (firestore lands with GCP setup)
SUBPOENA_PUBLISHER=log             # memory | log (pubsub lands with GCP setup)
SUBPOENA_API_KEY_PEPPER=           # required outside local/test
SUBPOENA_SEED_DIR=data/seed
