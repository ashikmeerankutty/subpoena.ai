{
  "$defs": {
    "Channel": {
      "enum": [
        "WHATSAPP",
        "SMS",
        "VOICE",
        "PUSH"
      ],
      "title": "Channel",
      "type": "string"
    },
    "EvaluationOptions": {
      "additionalProperties": false,
      "properties": {
        "sync_timeout_ms": {
          "default": 8000,
          "maximum": 30000,
          "minimum": 0,
          "title": "Sync Timeout Ms",
          "type": "integer"
        },
        "callback_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Callback Url"
        }
      },
      "title": "EvaluationOptions",
      "type": "object"
    },
    "Merchant": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "mcc": {
          "description": "ISO 18245 merchant category code",
          "pattern": "^\\d{4}$",
          "title": "Mcc",
          "type": "string"
        },
        "country": {
          "description": "ISO 3166-1 alpha-2",
          "pattern": "^[A-Z]{2}$",
          "title": "Country",
          "type": "string"
        }
      },
      "required": [
        "name",
        "mcc",
        "country"
      ],
      "title": "Merchant",
      "type": "object"
    },
    "TransactionMetadata": {
      "additionalProperties": false,
      "properties": {
        "ip_address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ip Address"
        },
        "device_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Fingerprint"
        },
        "user_agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Agent"
        }
      },
      "title": "TransactionMetadata",
      "type": "object"
    },
    "TransactionType": {
      "enum": [
        "CARD_PRESENT",
        "CARD_NOT_PRESENT",
        "P2P",
        "WIRE",
        "ACH"
      ],
      "title": "TransactionType",
      "type": "string"
    },
    "Witness": {
      "additionalProperties": false,
      "properties": {
        "phone": {
          "description": "E.164 phone number",
          "pattern": "^\\+[1-9]\\d{6,14}$",
          "title": "Phone",
          "type": "string"
        },
        "allowed_channels": {
          "items": {
            "$ref": "#/$defs/Channel"
          },
          "title": "Allowed Channels",
          "type": "array"
        },
        "locale": {
          "default": "en-US",
          "title": "Locale",
          "type": "string"
        }
      },
      "required": [
        "phone"
      ],
      "title": "Witness",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "transaction_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Transaction Id",
      "type": "string"
    },
    "user_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "User Id",
      "type": "string"
    },
    "amount": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Amount"
    },
    "currency": {
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/TransactionType"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "merchant": {
      "$ref": "#/$defs/Merchant"
    },
    "metadata": {
      "$ref": "#/$defs/TransactionMetadata"
    },
    "witness": {
      "anyOf": [
        {
          "$ref": "#/$defs/Witness"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "options": {
      "$ref": "#/$defs/EvaluationOptions"
    }
  },
  "required": [
    "transaction_id",
    "user_id",
    "amount",
    "currency",
    "type",
    "occurred_at",
    "merchant"
  ],
  "title": "EvaluationRequest",
  "type": "object"
}
